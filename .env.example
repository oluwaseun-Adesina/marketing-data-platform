# Copy to .env (git-ignored) for local development, then: set -a; source .env; set +a
DBT_PROFILES_DIR=.
DBT_TARGET=dev
DBT_DEV_USER=yourname

DATABRICKS_HOST=dbc-xxxxxxxx-xxxx.cloud.databricks.com
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/xxxxxxxxxxxxxxxx
DATABRICKS_TOKEN=dapi...            # dev only. NEVER used by ci or prod

# Only needed to run the ci/prod targets locally (normally set by GitHub Actions)
# DATABRICKS_CLIENT_ID=
# DATABRICKS_CLIENT_SECRET=
